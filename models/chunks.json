{
 "kb_hash": "462a9d2c4b27b79be03c1bd22e5afa8e7d9c7b68",
 "chunks": [
  {
   "id": "绿萝#特征",
   "plant": "绿萝",
   "section": "特征",
   "text": "别名/学名：黄金葛、魔鬼藤；Epipremnum aureum。叶片心形、四季常绿，茎节容易生根，可以攀爬也可以垂吊，水培土培都能活，是室内最常见的新手绿植之一。",
   "source": "植物养护手册.txt",
   "aliases": [
    "黄金葛",
    "魔鬼藤",
    "Epipremnum aureum"
   ]
  },
  {
   "id": "绿萝#光照",
   "plant": "绿萝",
   "section": "光照",
   "text": "喜欢明亮的散射光，放在窗边但避开正午直射。光照过强容易叶片发黄发白，长期过暗则节间拉长、叶色变淡，整体长势变弱。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "绿萝#浇水",
   "plant": "绿萝",
   "section": "浇水",
   "text": "土培盆土表面干了再浇透，见干见湿，宁湿勿涝，托盘积水要及时倒掉。水培水位没过根系一半即可，水浑了换水，不要长期整株泡在水里。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "绿萝#温度",
   "plant": "绿萝",
   "section": "温度",
   "text": "适宜温度 15-25℃，冬季不低于 10℃，避免冷风直吹。温度过低会叶片发黄、生长停滞，寒潮时搬回室内。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "绿萝#施肥",
   "plant": "绿萝",
   "section": "施肥",
   "text": "春秋生长期每月一次稀薄液肥或观叶植物营养液，薄肥勤施；冬季基本停肥。水培可用低浓度水培营养液，换水时补几滴。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "绿萝#病虫害",
   "plant": "绿萝",
   "section": "病虫害",
   "text": "常见叶斑和根腐，多由浇水过多、通风不良引起；偶见红蜘蛛、介壳虫。可先用清水冲洗叶背，严重时剪除病叶并改善通风。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "绿萝#常见问题",
   "plant": "绿萝",
   "section": "常见问题",
   "text": "叶子发黄怎么办？先看是否浇水过频或暴晒，减少浇水并移到散射光处。烂根怎么救？脱盆剪掉腐烂根，换透气基质重新栽种。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "多肉#特征",
   "plant": "多肉",
   "section": "特征",
   "text": "别名/学名：多肉植物、肉质植物；景天科、仙人掌科等多科植物统称。叶片肥厚多汁，形状颜色丰富，大部分春秋生长，夏天高温会进入休眠。",
   "source": "植物养护手册.txt",
   "aliases": [
    "多肉植物",
    "肉质植物",
    "景天科",
    "仙人掌科等多科植物统称"
   ]
  },
  {
   "id": "多肉#光照",
   "plant": "多肉",
   "section": "光照",
   "text": "喜欢晒太阳，但夏天要适当遮阴，不然容易晒伤；缺光会徒长变丑，株型松散。春秋可以多晒，夏冬注意控温控光。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "多肉#浇水",
   "plant": "多肉",
   "section": "浇水",
   "text": "干透浇透，宁干勿湿，盆土完全干后再浇。夏天休眠期更得控水，一个月给一点就行；冬天低温也要少浇，托盘不要积水。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "多肉#温度",
   "plant": "多肉",
   "section": "温度",
   "text": "适宜温度 15-28℃，冬天别低于 5℃，夏天别超 35℃。高温高湿时容易烂根，需要加强通风。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "多肉#施肥",
   "plant": "多肉",
   "section": "施肥",
   "text": "春秋生长期每月一次稀薄液肥，浓度要低；冬天和夏天基本不施肥。新上盆或换盆后先缓苗，不要马上施肥。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "多肉#病虫害",
   "plant": "多肉",
   "section": "病虫害",
   "text": "常见根腐、黑腐，多由积水和闷热引起；偶见介壳虫、蚜虫。发现腐烂要及时脱盆清理，剪口晾干后再上盆。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "多肉#常见问题",
   "plant": "多肉",
   "section": "常见问题",
   "text": "叶片变软发皱怎么办？多半是缺水或根系受损，先查盆土和根系。徒长了怎么处理？增加光照，必要时砍头重新扦插。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "仙人掌#特征",
   "plant": "仙人掌",
   "section": "特征",
   "text": "别名/学名：仙人掌科植物；Opuntia spp.。茎肉质多汁，表面常有刺或绒毛，体内储水能力强，耐旱好养，花期短但开花很醒目。",
   "source": "植物养护手册.txt",
   "aliases": [
    "仙人掌科植物",
    "Opuntia spp"
   ]
  },
  {
   "id": "仙人掌#光照",
   "plant": "仙人掌",
   "section": "光照",
   "text": "特别爱晒太阳，适合朝南窗台，光照越足越壮。光线不足会越长越瘦、刺变弱；夏季正午极端暴晒时可稍遮阴。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "仙人掌#浇水",
   "plant": "仙人掌",
   "section": "浇水",
   "text": "耐旱能力极强，盆土干透了再浇，宁干勿湿。冬天几乎可以断水，低温加潮湿最容易烂根。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "仙人掌#温度",
   "plant": "仙人掌",
   "section": "温度",
   "text": "喜欢温暖，20-30℃长得欢，冬天别低于 5℃，怕冻。夜间温差大有利于生长，但要避免霜冻。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "仙人掌#施肥",
   "plant": "仙人掌",
   "section": "施肥",
   "text": "生长季每月一次稀薄液肥，用仙人掌专用肥更好；冬天停肥。施肥前后保持盆土微干，避免浓肥烧根。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "仙人掌#病虫害",
   "plant": "仙人掌",
   "section": "病虫害",
   "text": "常见根腐和茎腐，多因浇水过多；偶见介壳虫、红蜘蛛。发现虫害可人工清除并隔离，改善通风。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "仙人掌#常见问题",
   "plant": "仙人掌",
   "section": "常见问题",
   "text": "球体发软怎么办？先摸盆土是否过湿，烂根要脱盆修根。长期不长大？检查光照和盆土，适当换盆。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "吊兰#特征",
   "plant": "吊兰",
   "section": "特征",
   "text": "别名/学名：挂兰、折鹤兰、钓兰；Chlorophytum comosum。叶片细长下垂，像绿色瀑布，还会抽出小吊兰，繁殖很快，适合悬挂或高台摆放。",
   "source": "植物养护手册.txt",
   "aliases": [
    "挂兰",
    "折鹤兰",
    "钓兰",
    "Chlorophytum comosum"
   ]
  },
  {
   "id": "吊兰#光照",
   "plant": "吊兰",
   "section": "光照",
   "text": "喜欢半阴，明亮的散射光就行，强光会晒焦叶尖。放在离窗不远的位置，避免正午直射，光照过暗则叶色变淡。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "吊兰#浇水",
   "plant": "吊兰",
   "section": "浇水",
   "text": "盆土表面干了就浇透，见干见湿，水多容易烂根。空气干燥时可以往叶面周围喷水增湿，但不要长期让盆土泡水。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "吊兰#温度",
   "plant": "吊兰",
   "section": "温度",
   "text": "适宜温度 15-25℃，冬天别低于 5℃，最好放室内。低温加浇水过多容易烂根黄叶。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "吊兰#施肥",
   "plant": "吊兰",
   "section": "施肥",
   "text": "春秋每月一次稀薄液肥，薄肥勤施；冬天减少或停止施肥。水培吊兰可少量补充水培营养液。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "吊兰#病虫害",
   "plant": "吊兰",
   "section": "病虫害",
   "text": "常见叶尖干枯、根腐，多与强光、积水和空气干燥有关；偶见介壳虫。定期修剪枯叶、保持通风。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "吊兰#常见问题",
   "plant": "吊兰",
   "section": "常见问题",
   "text": "叶尖发黄干枯怎么办？多因暴晒或自来水偏硬，移到散射光处并偶尔用晾过的水。小吊兰怎么繁殖？剪下带气生根的小苗水培或直接上盆。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "月季#特征",
   "plant": "月季",
   "section": "特征",
   "text": "别名/学名：月月红、月月开；Rosa chinensis。花色品种很多，有的香有的不香，春秋开花最旺，枝条带刺，常被称为“药罐子”。",
   "source": "植物养护手册.txt",
   "aliases": [
    "月月红",
    "月月开",
    "Rosa chinensis"
   ]
  },
  {
   "id": "月季#光照",
   "plant": "月季",
   "section": "光照",
   "text": "每天至少要 6 小时直晒，光照不足不开花或花量少。通风要好，荫蔽潮湿的环境容易生病。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "月季#浇水",
   "plant": "月季",
   "section": "浇水",
   "text": "见干见湿，浇就浇透，夏天多浇，注意通风别闷根。盆栽可用手指探土，表面干了再浇，托盘积水倒掉。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "月季#温度",
   "plant": "月季",
   "section": "温度",
   "text": "适宜温度 15-26℃，耐热耐寒较强，冬天低于 -5℃ 要防护。盛夏高温时适当遮阴，避免花朵晒焦。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "月季#施肥",
   "plant": "月季",
   "section": "施肥",
   "text": "生长期每周一次复合肥，开花前补磷钾肥，冬天少施肥。薄肥勤施，浓肥容易烧根。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "月季#病虫害",
   "plant": "月季",
   "section": "病虫害",
   "text": "常见白粉病、黑斑病和蚜虫、红蜘蛛，需要通风和及时修剪病叶。发现病叶尽早摘除，避免雨水传播。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "月季#常见问题",
   "plant": "月季",
   "section": "常见问题",
   "text": "不开花怎么办？先看光照是否足够，再检查修剪和施肥。叶子有黑斑？摘除病叶并改善通风，避免叶面长期积水。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "茉莉#特征",
   "plant": "茉莉",
   "section": "特征",
   "text": "别名/学名：茉莉花、阿拉伯茉莉；Jasminum sambac。小叶翠绿，开白色小花，香味浓郁，夏天开花勤快，是常见的香花植物。",
   "source": "植物养护手册.txt",
   "aliases": [
    "茉莉花",
    "阿拉伯茉莉",
    "Jasminum sambac"
   ]
  },
  {
   "id": "茉莉#光照",
   "plant": "茉莉",
   "section": "光照",
   "text": "特别喜欢晒，越晒花越多，光照不足香味也会变淡。每天尽量保证充足直射光，夏季高温时注意补水。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "茉莉#浇水",
   "plant": "茉莉",
   "section": "浇水",
   "text": "盆土一干就浇透，夏天可能每天都要浇，别积水就行。见干见湿，花期忌忽干忽湿导致落蕾。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "茉莉#温度",
   "plant": "茉莉",
   "section": "温度",
   "text": "喜欢温暖湿润，25-35℃ 长得快，冬天要搬进室内，别低于 5℃。低温会落叶休眠。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "茉莉#施肥",
   "plant": "茉莉",
   "section": "施肥",
   "text": "生长期每月两三次腐熟稀薄液肥，开花前补磷钾，冬天停肥。浓度要低，避免烧根。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "茉莉#病虫害",
   "plant": "茉莉",
   "section": "病虫害",
   "text": "常见红蜘蛛、介壳虫、叶斑病，多与干燥闷热有关。保持通风，发现虫害尽早处理。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "茉莉#常见问题",
   "plant": "茉莉",
   "section": "常见问题",
   "text": "光长叶不开花？多是光照不足或氮肥偏多，增加日照并补充磷钾。香味淡？光照和温差不足，尽量多晒。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "龟背竹#特征",
   "plant": "龟背竹",
   "section": "特征",
   "text": "别名/学名：蓬莱蕉、电线兰；Monstera deliciosa。叶片大而开裂，像龟背上的豁口，热带气息浓，适合摆在客厅角落当观叶大盆栽。",
   "source": "植物养护手册.txt",
   "aliases": [
    "蓬莱蕉",
    "电线兰",
    "Monstera deliciosa"
   ]
  },
  {
   "id": "龟背竹#光照",
   "plant": "龟背竹",
   "section": "光照",
   "text": "喜欢散射光，怕强光直晒，放在明亮通风的角落就行。光照过暗会让新叶开裂少、长势弱。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "龟背竹#浇水",
   "plant": "龟背竹",
   "section": "浇水",
   "text": "盆土干一半就浇水，保持微湿，见干见湿，别长期泡水。空气干燥时可以多给叶面周围喷水。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "龟背竹#温度",
   "plant": "龟背竹",
   "section": "温度",
   "text": "适宜温度 20-30℃，冬天别低于 10℃，否则容易冻蔫。避免冷风直吹和空调出风口。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "龟背竹#施肥",
   "plant": "龟背竹",
   "section": "施肥",
   "text": "生长期每月一次稀薄复合肥，薄肥勤施；冬天停肥。换盆后先缓苗，不要急着施肥。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
   "id": "龟背竹#病虫害",
   "plant": "龟背竹",
   "section": "病虫害",
   "text": "常见叶斑、根腐，多由积水和通风不良引起；偶见介壳虫。病叶及时剪除，保持环境通风。",
   "source": "植物养护手册.txt",
   "aliases": []
  },
  {
